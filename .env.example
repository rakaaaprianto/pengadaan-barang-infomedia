# Google Sheets Service Account Configuration
GOOGLE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Mode mock data lokal (default: false). Set true jika ingin mencoba tanpa koneksi Google Sheets.
MOCK_SHEETS=false
